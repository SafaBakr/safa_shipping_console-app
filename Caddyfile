# Automatic HTTPS (Let's Encrypt) for the domain in .env
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header -Server
	reverse_proxy app:3000
}

{$STAGING_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header -Server
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy app-staging:3000
}
