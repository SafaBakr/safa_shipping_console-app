# ============ Safa Shipping Console — server settings ============
# Copy this file to .env and fill in the values:   cp .env.example .env

# Domain pointing to this server (A record). Use :80 for a first test without a domain (HTTP only).
DOMAIN=erp.example.com
# Optional staging domain (start with: docker compose --profile staging up -d)
STAGING_DOMAIN=staging.example.com
# Email for the HTTPS certificate notices
ACME_EMAIL=you@example.com

# Long random values — generate each with:  openssl rand -hex 32
DB_PASSWORD=
SESSION_SECRET=
STAGING_SESSION_SECRET=
# Encrypts every backup file. KEEP A COPY OUTSIDE THE SERVER: without it backups cannot be restored.
BACKUP_PASSPHRASE=

# Administrator (receives new-account requests)
ADMIN_EMAIL=safabakr6.2@gmail.com
SITE_NAME=Safa Shipping Console

# Outgoing email (Gmail: create an App Password in the Google account security settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=safabakr6.2@gmail.com
SMTP_PASS=

# Backups: daily at 02:30 (cron format), keep 14 days on the server
BACKUP_CRON=30 2 * * *
BACKUP_KEEP_DAYS=14
# Off-site copy with rclone (e.g. "gdrive:safa-backups"); put the rclone config in deploy/rclone/rclone.conf first. Leave empty to disable.
RCLONE_REMOTE=

TZ=Asia/Damascus
